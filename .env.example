# ==============================================================================
# RND CADD TRAINING INSTITUTE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MONGODB DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# For MongoDB Atlas (Cloud Cluster):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-domain>.mongodb.net/rnd_cadd?retryWrites=true&w=majority
# For Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/rnd_cadd
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rnd_cadd?retryWrites=true&w=majority
MONGODB_DB=rnd_cadd

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE CLOUD STORAGE (FOR COURSE IMAGES & MEDIA ASSETS)
# ------------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible Object Storage with Zero Egress Fees)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=rndcadd-assets
CLOUDFLARE_R2_PUBLIC_URL=https://pub-yourbucket.r2.dev

# (Optional) Cloudflare Images API Token
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# 3. SMTP EMAIL NOTIFICATIONS (STUDENT ADMISSIONS & SYSTEM ALERTS)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RND CADD Training Institute <no-reply@rndcadd.com>"
