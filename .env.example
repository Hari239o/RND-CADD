# ==============================================================================
# RND CADD TRAINING INSTITUTE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MONGODB DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rnd_cadd?retryWrites=true&w=majority
MONGODB_DB=rnd_cadd

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH 2.0 (SIGN IN & SIGN UP WITH GOOGLE)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE CLOUD STORAGE (FOR COURSE IMAGES & MEDIA ASSETS)
# ------------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=rndcadd-assets
CLOUDFLARE_R2_PUBLIC_URL=https://pub-yourbucket.r2.dev

# (Optional) Cloudflare Images API Token
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# 4. SMTP EMAIL NOTIFICATIONS (GMAIL APP PASSWORD / OTP / NOTIFICATIONS)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=rndcadd@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="RND CADD Training Institute" <rndcadd@gmail.com>
